# Local configs hold account IDs, endpoints and credentials references — never commit them.
# Anything under config/ (files, sub-folders, CA bundles) except the example.
/config/*
!/config/example.yaml
.public-denylist

# Generated data. Runs ARE committed (neutral backend names), but each run's config snapshot
# holds deployment details (account, endpoints, client ids) and never leaves this machine.
docs-out/
runs/*/config.yaml
runs/*/config.yml
runs/*/config.yaml.*
runs/*/config.yml.*
# written during an extract pass; left behind only if the pass crashes
runs/*/extractions.partial.jsonl
results/
site/
*.tfplan

# Tooling
.tools/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/
*.egg-info/

# Terraform
infra/terraform/.terraform/
infra/terraform/backend.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash*.log
**/.terraform/
*.tfvars
*.tfvars.json
.terraformrc
terraform.rc

# Extra CA bundles / secrets
*.pem
*.key
*.p12
*.pfx
.env
.env.*
.envrc
.DS_Store
infra/terraform/backend.tf
.state/

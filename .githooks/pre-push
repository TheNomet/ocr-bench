#!/usr/bin/env bash
# args: <remote name> <url>; stdin: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
guard="$(git rev-parse --show-toplevel)/scripts/public_guard.sh"
remote=${1:-}
zero=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')
while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion: nothing to scan
  # Ref names and annotated tags (tagger, message, nested tags) are public as well.
  {
    printf '%s\n' "$remote_ref"
    obj=$local_sha
    while [ "$(git cat-file -t "$obj")" = tag ]; do
      git cat-file tag "$obj"
      obj=$(git cat-file tag "$obj" | sed -n '1s/^object //p')
    done
  } | "$guard" text || {
    echo "pre-push: blocked by a ref name or annotated tag (stdin line 1 = remote ref name, then \`git cat-file tag\`)" >&2
    exit 1
  }
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$guard" range "$remote_sha..$local_sha"
  else
    # New branch, or a remote tip we don't have (e.g. after a force-push): scan every commit not
    # already on this remote. A push to a bare URL matches no remote refs, so all history is scanned.
    if [ -n "$remote" ]; then "$guard" range "$local_sha" --not --remotes="$remote"; else "$guard" range "$local_sha"; fi
  fi
done
